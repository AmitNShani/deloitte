# Copy to .env and fill in. All optional: keys can also be pasted into the app's sidebar
# (kept in session memory only).

# Provider used by default: anthropic | openai | gemini | openai-compatible
LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# LLM_EFFORT=medium            # Claude only: low | medium | high | xhigh | max

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local speech-to-text model for voice questions: tiny.en | base.en | small.en | medium.en
# WHISPER_MODEL=base.en

# For openai-compatible servers (Ollama, vLLM, LM Studio, ...)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
